# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase.
# Ce sont des valeurs publiques (clé "publishable"), protégées par les règles RLS.
# Ne jamais mettre ici la clé secrète (service_role).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
